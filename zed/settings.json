{
  "prettier": {
    "allowed": true,
  },
  "format_on_save": "on",
  "unnecessary_code_fade": 0.3,
  "disable_ai": true,
  "edit_predictions": {
    "allow_data_collection": "no",
  },
  "buffer_font_weight": 400.0,
  "terminal": {
    "font_family": "JetBrains Mono",
  },
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "split",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "enable_feedback": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "ui_font_weight": 400.0,
  "ui_font_family": "Roboto",
  "project_panel": {
    "dock": "left",
    "diagnostic_badges": true,
    "indent_size": 20.0,
    "entry_spacing": "standard",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "agent_ui_font_size": 12.0,
  "buffer_line_height": {
    "custom": 1.4,
  },
  "buffer_font_family": "JetBrains Mono",
  "base_keymap": "JetBrains",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 15.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Rosé Pine",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "languages": {
    "Dart": {
      "format_on_save": "on",
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.fixAll": true,
        "source.organizeImports": true,
      },
    },
    "Rust": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
  },
  "lsp": {
    "dart": {
      "binary": {
        "path": "/usr/custom/flutter/bin/dart",
        "arguments": ["language-server", "--protocol=lsp"],
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
  },
}
